{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
    "globals": {
    "ts-jest": {
      "tsconfig": {
        "allowJs": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "rootDir": "../../"
      }
    }
  },
  "transformIgnorePatterns": ["/node_modules/(?!xmlbuilder2|@oozcitak)/"]
}
